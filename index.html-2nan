<!DOCTYPE html>
<html lang="fr">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Pourquoi ça ne va pas</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
}

body{
height:100vh;
background:black;
display:flex;
justify-content:center;
align-items:center;
font-family:Arial,sans-serif;
overflow:hidden;
}


.container{
text-align:center;
}


/* Enveloppe */

.envelope{
width:280px;
height:180px;
background:white;
border-radius:10px;
position:relative;
transition:1s;
overflow:hidden;
}


.envelope.open{
transform:translateY(120px);
}


.flap{
position:absolute;
top:0;
left:0;
border-left:140px solid transparent;
border-right:140px solid transparent;
border-top:100px solid #ddd;
transition:1s;
z-index:3;
}


.open .flap{
transform:translateY(-120px);
}


/* Coeur brisé */

.heart{
position:absolute;
top:55px;
left:105px;
font-size:65px;
cursor:pointer;
z-index:5;
}


/* Lettre */

.letter{

position:absolute;
width:230px;
height:330px;
background:white;
left:25px;
top:-320px;
border-radius:10px;
box-shadow:0 0 25px white;
transition:1s;
overflow:hidden;

}


.show-letter{
top:-350px;
}



.top,
.bottom{

height:50%;
background:#fff;
transition:1s;

}


.top{
border-bottom:1px solid #ddd;
}


.top.open{
transform:translateY(-100%);
}


.bottom.open{
transform:translateY(100%);
}



.message{

display:none;
font-size:22px;
font-weight:bold;
padding:20px;
color:#222;

}


/* Zone texte */

textarea{

display:none;
margin-top:20px;
width:260px;
height:100px;
border-radius:10px;
padding:12px;
font-size:16px;
resize:none;

}



/* Bouton */

button{

display:none;
margin-top:15px;
padding:12px 35px;
border:none;
border-radius:25px;
background:#00c853;
color:white;
font-size:18px;
cursor:pointer;

}


button:hover{
transform:scale(1.05);
}


</style>

</head>


<body>


<div class="container">


<div class="envelope" id="envelope">


<div class="flap"></div>


<div class="heart" onclick="ouvrir()">
💔
</div>



<div class="letter" id="letter">


<div class="top" id="top"></div>

<div class="bottom" id="bottom"></div>


<div class="message" id="message">
Pourquoi ça ne va pas ?
</div>


</div>


</div>



<textarea id="problem" placeholder="Écris ton problème ici..."></textarea>


<button id="send" onclick="envoyer()">
Envoyer
</button>


</div>



<script>


let etape=0;


function ouvrir(){


let envelope=document.getElementById("envelope");
let letter=document.getElementById("letter");


if(etape===0){


envelope.classList.add("open");


setTimeout(()=>{

letter.classList.add("show-letter");

},800);


etape++;


}

else if(etape===1){


document.getElementById("top").classList.add("open");

etape++;


}

else if(etape===2){


document.getElementById("bottom").classList.add("open");


setTimeout(()=>{


document.getElementById("message").style.display="block";

document.getElementById("problem").style.display="block";

document.getElementById("send").style.display="inline-block";


},1000);


etape++;

}


}



function envoyer(){


let texte=document.getElementById("problem").value;


localStorage.setItem("probleme", texte);


window.location.href="Index.html-3nan.html";


}


</script>


</body>
</html>